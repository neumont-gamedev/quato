{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "database": "(default)",
    "location": "nam5"
  },
  "auth": {
    "authorizedDomains": [
      "localhost",
      "quato-1512c.web.app",
      "quato-1512c.firebaseapp.com"
    ],
    "providers": {
      "anonymous": true
    }
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "node functions/scripts/sync-quizzes.js"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
