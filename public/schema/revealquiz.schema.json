{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revealquiz.local/schema/revealquiz.schema.json",
  "title": "RevealQuiz Quiz",
  "type": "object",
  "required": ["title", "questions"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bossMultiplier": { "type": "number", "minimum": 1, "maximum": 10 }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "baseQuestion": {
      "type": "object",
      "required": ["id", "type", "question"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "enum": ["multiple-choice", "true-false", "fill-blank", "code-question"] },
        "question": { "type": "string", "minLength": 1 },
        "points": { "type": "integer", "minimum": 1 },
        "timeLimit": { "type": "integer", "minimum": 1 },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "explanation": { "type": "string" }
      }
    },
    "question": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/baseQuestion" },
            {
              "type": "object",
              "required": ["answers", "correct"],
              "properties": {
                "type": { "const": "multiple-choice" },
                "answers": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "type": "string", "minLength": 1 }
                },
                "correct": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseQuestion" },
            {
              "type": "object",
              "required": ["answer"],
              "properties": {
                "type": { "const": "true-false" },
                "answer": { "type": "boolean" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseQuestion" },
            {
              "type": "object",
              "required": ["answers"],
              "properties": {
                "type": { "const": "fill-blank" },
                "answers": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "caseSensitive": { "type": "boolean" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseQuestion" },
            {
              "type": "object",
              "required": ["code", "answers", "correct"],
              "properties": {
                "type": { "const": "code-question" },
                "language": { "type": "string" },
                "code": { "type": "string", "minLength": 1 },
                "answers": {
                  "type": "array",
                  "minItems": 2,
                  "items": { "type": "string", "minLength": 1 }
                },
                "correct": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        }
      ]
    }
  }
}
